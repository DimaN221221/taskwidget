<Window x:Class="TaskWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Задачі на день"
        Icon="Assets/app.ico"
        Width="340" Height="540"
        MinWidth="280" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F7F6F2"
        BorderBrush="#E4E2DA"
        BorderThickness="1">

    <!-- Frameless window that can still be resized from its edges.
         The page draws its own title bar; dragging is handled in MainWindow.xaml.cs. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- The margin leaves a strip of WPF surface around the browser for the resize grips. -->
    <wv2:WebView2 x:Name="Web" Margin="5" DefaultBackgroundColor="Transparent" />
</Window>
