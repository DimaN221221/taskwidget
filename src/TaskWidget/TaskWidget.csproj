<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskWidget</RootNamespace>
    <AssemblyName>TaskWidget</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- keep dist\ down to the exe alone -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>

    <Product>Задачі на день</Product>
    <!-- The one version number for both apps: android\app\build.gradle reads it from here,
         and release.bat publishes it as the GitHub release vX.Y.Z. -->
    <Version>1.4.0</Version>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- The UI lives in wwwroot and is compiled into the exe, so the app is a single file.
       Edit wwwroot\index.html and rebuild; the resource names become "wwwroot/<path>".
       The Android app (android\) packs the same wwwroot folder. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
